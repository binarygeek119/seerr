FROM node:22.22.2-alpine3.23@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=development

RUN corepack enable && \
  apk add --no-cache tzdata libc6-compat

WORKDIR /app

# Dependencies layer (rebuild when lockfile changes)
COPY package.json pnpm-lock.yaml ./
RUN CYPRESS_INSTALL_BINARY=0 pnpm install --frozen-lockfile

COPY . .

RUN mkdir -p config/db config/logs config/cache/images && \
  touch config/DOCKER

EXPOSE 5055

CMD ["pnpm", "dev"]
